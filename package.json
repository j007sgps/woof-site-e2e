{
  "name": "woof-site-e2e",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test": "playwright test",
    "test:e2e": "playwright test --grep-invert \"@a11y|@visual\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:visual": "playwright test --grep @visual",
    "test:update-snapshots": "playwright test --grep @visual --update-snapshots",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
